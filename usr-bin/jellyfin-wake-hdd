#!/bin/bash

set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONFIG_FILE="${JELLYFIN_WAKE_HDD_CONFIG:-/etc/jellyfin-wake-hdd.conf}"

# Defaults; anything set in the config file overrides these.
JELLYFIN_URL="http://localhost:8096"
JELLYFIN_API_KEY=""
WAKE_PATHS=()
CURL_TIMEOUT=3
MIN_SESSIONS=1

if [ -r "$CONFIG_FILE" ]; then
    # shellcheck source=/etc/jellyfin-wake-hdd.conf
    source "$CONFIG_FILE"
else
    echo "jellyfin-wake-hdd: config file $CONFIG_FILE not found or not readable" >&2
    exit 1
fi

if [ -z "$JELLYFIN_API_KEY" ]; then
    echo "jellyfin-wake-hdd: JELLYFIN_API_KEY is not set in $CONFIG_FILE" >&2
    exit 1
fi

if [ "${#WAKE_PATHS[@]}" -eq 0 ]; then
    echo "jellyfin-wake-hdd: WAKE_PATHS is empty in $CONFIG_FILE — nothing to wake" >&2
    exit 1
fi

# Run curl in a subshell so we can handle non-zero exit codes instead of
# exiting due to set -x.
if ! response="$(
    curl -sS --max-time "$CURL_TIMEOUT" -w '\n%{http_code}' \
        -H "Authorization: MediaBrowser Token=\"${JELLYFIN_API_KEY}\"" \
        "${JELLYFIN_URL%/}/Sessions"
)"; then
    response=$'\n000'
fi
http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
    echo "jellyfin-wake-hdd: ${JELLYFIN_URL} rejected JELLYFIN_API_KEY (HTTP ${http_code}) — check the key is valid and has not been revoked" >&2
    exit 1
fi

if [[ ! "$http_code" =~ ^2 ]]; then
    echo "jellyfin-wake-hdd: ${JELLYFIN_URL}/Sessions returned HTTP ${http_code}" >&2
    exit 1
fi

session_count="$(jq 'length' <<< "$body" 2>/dev/null)"

if ! [[ "$session_count" =~ ^[0-9]+$ ]]; then
    echo "jellyfin-wake-hdd: unexpected response from ${JELLYFIN_URL} (could not parse session count)" >&2
    exit 1
fi

if [ "$session_count" -ge "$MIN_SESSIONS" ]; then
    echo "jellyfin-wake-hdd: ${session_count} active session(s) — waking drives"
    # stat (rather than a full read) is enough to force the enclosure to
    # spin up without reading meaningful data off the disks.
    stat "${WAKE_PATHS[@]}" > /dev/null
else
    echo "jellyfin-wake-hdd: ${session_count} active session(s) — nothing to do"
fi
