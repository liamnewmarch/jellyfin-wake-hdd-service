#!/bin/bash

set -euo pipefail

PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

CONFIG_FILE="${JELLYFIN_WAKE_HDD_CONFIG:-/etc/jellyfin-wake-hdd.conf}"

# Defaults; anything set in the config file overrides these.
JELLYFIN_URL="http://localhost:8096"
JELLYFIN_API_KEY=""
WAKE_PATHS=()
CURL_TIMEOUT=3
MIN_SESSIONS=1

if [ -r "$CONFIG_FILE" ]; then
    # shellcheck source=/etc/jellyfin-wake-hdd.conf
    source "$CONFIG_FILE"
else
    echo "jellyfin-wake-hdd: config file $CONFIG_FILE not found or not readable" >&2
    exit 1
fi

if [ -z "$JELLYFIN_API_KEY" ]; then
    echo "jellyfin-wake-hdd: JELLYFIN_API_KEY is not set in $CONFIG_FILE" >&2
    exit 1
fi

if [ "${#WAKE_PATHS[@]}" -eq 0 ]; then
    echo "jellyfin-wake-hdd: WAKE_PATHS is empty in $CONFIG_FILE — nothing to wake" >&2
    exit 1
fi

# Run curl in a subshell so we can handle non-zero exit codes instead of
# exiting due to set -e.
if ! response="$(
    curl -sS --max-time "$CURL_TIMEOUT" -w '\n%{http_code}' \
        -H "Authorization: MediaBrowser Token=\"${JELLYFIN_API_KEY}\"" \
        "${JELLYFIN_URL%/}/Sessions"
)"; then
    response=$'\n000'
fi
http_code="${response##*$'\n'}"
body="${response%$'\n'*}"

if [ "$http_code" = "401" ] || [ "$http_code" = "403" ]; then
    echo "jellyfin-wake-hdd: ${JELLYFIN_URL} rejected JELLYFIN_API_KEY (HTTP ${http_code}) — check the key is valid and has not been revoked" >&2
    exit 1
fi

if [[ ! "$http_code" =~ ^2 ]]; then
    echo "jellyfin-wake-hdd: ${JELLYFIN_URL}/Sessions returned HTTP ${http_code}" >&2
    exit 1
fi

session_count="$(jq 'length' <<< "$body" 2>/dev/null)"

if ! [[ "$session_count" =~ ^[0-9]+$ ]]; then
    echo "jellyfin-wake-hdd: unexpected response from ${JELLYFIN_URL} (could not parse session count)" >&2
    exit 1
fi

# Wake the drive behind a path by reading one 4 KiB block from its block
# device. A stat() isn't enough: the kernel answers it from the dentry/inode
# cache (Jellyfin's file watchers keep library folders cached), so the disk
# is never touched. O_DIRECT bypasses the page cache, and a random offset
# avoids being served from the drive's own buffer.
wake_path() {
    local path="$1" device size blocks
    device="$(findmnt -n -o SOURCE --target "$path" 2>/dev/null)" || device=""
    device="${device%%\[*}"  # btrfs reports /dev/sdX[/subvolume]
    if [ ! -b "$device" ]; then
        echo "jellyfin-wake-hdd: no block device found behind ${path} (mount source: '${device}')" >&2
        return 1
    fi
    size="$(blockdev --getsize64 "$device")"
    blocks=$(( size / 4096 ))
    if [ "$blocks" -lt 1 ]; then
        echo "jellyfin-wake-hdd: ${device} (for ${path}) is smaller than 4 KiB" >&2
        return 1
    fi
    if ! dd if="$device" of=/dev/null bs=4096 count=1 \
        skip=$(( (RANDOM * 32768 + RANDOM) % blocks )) iflag=direct status=none; then
        echo "jellyfin-wake-hdd: failed to read from ${device} (for ${path})" >&2
        return 1
    fi
}

if [ "$session_count" -ge "$MIN_SESSIONS" ]; then
    echo "jellyfin-wake-hdd: ${session_count} active session(s) — waking drives"
    failed=0
    for path in "${WAKE_PATHS[@]}"; do
        wake_path "$path" || failed=1
    done
    exit "$failed"
else
    echo "jellyfin-wake-hdd: ${session_count} active session(s) — nothing to do"
fi
