#!/usr/bin/make -f

%:
	dh $@

# The unit needs a valid API key and wake paths before it can do
# anything useful, so install it enabled-at-boot but don't start it
# during the package install itself — see debian/postinst for the
# post-install message pointing at the config file.
#
# --no-stop-on-upgrade keeps an already-running timer running across
# upgrades; without it dpkg stops the timer and --no-start leaves it
# stopped until the next reboot.
override_dh_installsystemd:
	dh_installsystemd --no-start --no-stop-on-upgrade

# The config holds the Jellyfin API key, so keep it readable by root only.
override_dh_fixperms:
	dh_fixperms
	chmod 0600 debian/jellyfin-wake-hdd/etc/jellyfin-wake-hdd.conf
